rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : 'Lector'; }
    function hasAny(roles) { return signedIn() && role() in roles; }

    match /books/{bookId} {
      allow read: if true;
      allow create: if hasAny(['Master', 'Administrador', 'Editor']);
      allow update: if hasAny(['Master', 'Administrador', 'Editor']);
      allow delete: if hasAny(['Master', 'Administrador']);
    }
    match /categories/{id} { allow read: if true; allow write: if hasAny(['Master', 'Administrador']); }
    match /subjects/{id} { allow read: if true; allow write: if hasAny(['Master', 'Administrador']); }
    match /publicationTypes/{id} { allow read: if true; allow write: if hasAny(['Master', 'Administrador']); }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasAny(['Master', 'Administrador']));
      allow write: if hasAny(['Master']);
    }
    match /activity/{id} { allow read: if hasAny(['Master', 'Administrador', 'Editor']); allow create: if signedIn(); allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
