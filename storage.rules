rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : 'Lector'; }
    function canManageImages() { return role() in ['Master', 'Administrador', 'Editor']; }
    match /covers/{bookId}/{fileName} {
      allow read: if true;
      allow write: if canManageImages() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /gallery/{bookId}/{fileName} {
      allow read: if true;
      allow write: if canManageImages() && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
